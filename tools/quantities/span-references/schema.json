{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rows"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "rows": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "question",
            "answer"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "input",
            "step",
            "constant"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf",
        "source",
        "role",
        "evidence"
      ],
      "properties": {
        "leaf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignments"
      ],
      "properties": {
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason",
        "evidence",
        "programs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "equivalent",
            "ambiguous",
            "unsupported",
            "label_error"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "programs": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/program"
          }
        }
      }
    }
  }
}
