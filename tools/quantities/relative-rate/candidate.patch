+/// Canonical-coordinate elimination for dimension-checked callers.
+/// Physical dimensions are checked before erasing the expression types here.
+pub(crate) fn solve_typed(
+    constraints: Vec<ScalarExpr>,
+    target: ScalarExpr,
+    variables: usize,
+) -> Result<Rational> {
+    if !(1..=2).contains(&variables) || constraints.len() > 8 {
+        return Err("typed affine bounds exceeded".into());
+    }
+    Problem {
+        constraints: constraints.into_iter().map(Equality).collect(),
+        target,
+        pair: variables == 2,
+        differences: Vec::new(),
+    }
+    .execute()?
+    .ok_or("contradictory physical constraints".into())
