+++ b/crates/quantities/tests/work_rates.rs
@@ -0,0 +1,23 @@
+use glassmind_quantities::{Answer, solve};
+#[test]
+fn frozen_rate_and_stage_contracts() {
+    let cases: serde_json::Value = serde_json::from_str(include_str!(
+        "../../../tools/quantities/work-rates/cases.json"
+    ))
+    .unwrap();
+    for c in cases.as_array().unwrap() {
+        let question = c["question"].as_str().unwrap();
+        match solve(question) {
+            Answer::Answer {
+                value,
+                unit,
+                method,
+            } => {
+                assert_eq!(Some(value.as_str()), c["expected"].as_str(), "{question}");
+                assert_eq!(unit.as_deref(), c["unit"].as_str(), "{question}");
+                assert!(method.contains("constant independent rates"));
+            }
+            Answer::Refusal { .. } => assert!(c["expected"].is_null(), "{question}"),
+        }
+    }
+}
