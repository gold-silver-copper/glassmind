+++ 2/crates/quantities/src/proposal.rs
@@ -0,0 +1,324 @@
+//! Opt-in finite learned program proposals. Execution is not semantic verification.
+use crate::rational::{Rational, Result};
+use regex::Regex;
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    io::Read,
+    path::Path,
+    sync::OnceLock,
+};
+
+pub const CONSTANTS: [&str; 20] = [
+    "0", "1", "2", "3", "4", "5", "6", "10", "12", "26", "52", "60", "100", "180", "360", "1000",
+    "3600", "0.25", "3.6", "1.6",
+];
+pub const FEATURES: usize = 8192;
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(
+    tag = "kind",
+    content = "index",
+    rename_all = "snake_case",
+    deny_unknown_fields
+)]
+pub enum Arg {
+    Input(u8),
+    Step(u8),
+    Constant(u8),
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Op {
+    Add,
+    Subtract,
+    Multiply,
+    Divide,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Step {
+    pub op: Op,
+    pub left: Arg,
+    pub right: Arg,
+}
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Program {
+    pub steps: Vec<Step>,
+}
+#[derive(Clone, Debug, Serialize)]
+pub struct Number {
+    pub start: usize,
+    pub end: usize,
+    pub literal: String,
+    pub value: String,
+}
+
+pub fn numbers(question: &str) -> Result<Vec<Number>> {
+    if question.len() > 4096 {
+        return Err("input exceeds 4096 bytes".into());
+    }
+    if question
+        .chars()
+        .any(|c| c.is_numeric() && !c.is_ascii_digit())
+    {
+        return Err("unsupported Unicode numeric spelling".into());
+    }
+    let lower = question.to_ascii_lowercase();
+    let unsupported = "zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty thirty forty fifty sixty seventy eighty ninety hundred thousand million billion dozen half quarter";
+    if lower
+        .split(|c: char| !c.is_ascii_alphabetic())
+        .any(|w| !w.is_empty() && unsupported.split(' ').any(|n| n == w))
+    {
+        return Err("unsupported number word".into());
+    }
+    static RE: OnceLock<Result<Regex>> = OnceLock::new();
+    let re = RE
+        .get_or_init(|| {
+            Regex::new(r"[+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\.[0-9]+)?|[+-]?\.[0-9]+")
+                .map_err(|e| e.to_string())
+        })
+        .as_ref()
+        .map_err(Clone::clone)?;
+    let mut result = Vec::new();
+    for m in re.find_iter(question) {
+        let prefix = &question[..m.start()];
+        let before = prefix.chars().next_back();
+        if prefix.trim_end().ends_with(['+', '-', '−', '–', '—']) {
+            return Err("unsupported separated or Unicode numeric sign".into());
+        }
+        let after = question[m.end()..].chars().next();
+        let bad_neighbor = |c: char| {
+            c.is_alphanumeric() || c == '_' || c == '.' || c == ',' || c == '+' || c == '-'
+        };
+        // A final sentence period or comma followed by whitespace is punctuation.
+        let punctuation = matches!(after, Some('.' | ','))
+            && question[m.end() + 1..]
+                .chars()
+                .next()
+                .is_none_or(char::is_whitespace);
+        if before.is_some_and(bad_neighbor) || (after.is_some_and(bad_neighbor) && !punctuation) {
+            return Err("unsupported numeric spelling or boundary".into());
+        }
+        let value: Rational = m.as_str().replace(',', "").parse()?;
+        result.push(Number {
+            start: m.start(),
+            end: m.end(),
+            literal: m.as_str().into(),
+            value: value.to_string(),
+        });
+        if result.len() > 16 {
+            return Err("more than 16 numeric slots".into());
+        }
+    }
+    // Every digit must belong to a retained literal.
+    if question
+        .char_indices()
+        .any(|(i, c)| c.is_ascii_digit() && !result.iter().any(|n| n.start <= i && i < n.end))
+    {
+        return Err("unbound digit".into());
+    }
+    Ok(result)
+}
+impl Program {
+    pub fn validate(&self) -> Result<()> {
+        if self.steps.is_empty() || self.steps.len() > 6 {
+            return Err("program must contain 1..6 steps".into());
+        }
+        for (i, s) in self.steps.iter().enumerate() {
+            for a in [&s.left, &s.right] {
+                let valid = match a {
+                    Arg::Input(n) => *n < 16,
+                    Arg::Step(n) => usize::from(*n) < i,
+                    Arg::Constant(n) => usize::from(*n) < CONSTANTS.len(),
+                };
+                if !valid {
+                    return Err("invalid or forward program reference".into());
+                }
+            }
+        }
+        Ok(())
+    }
+    pub fn execute(&self, question: &str) -> Result<(Vec<Number>, Rational)> {
+        self.validate()?;
+        let nums = numbers(question)?;
+        let inputs = nums
+            .iter()
+            .map(|n| n.value.parse::<Rational>())
+            .collect::<Result<Vec<_>>>()?;
+        let mut values: Vec<Rational> = Vec::new();
+        for s in &self.steps {
+            let get = |a: &Arg| -> Result<Rational> {
+                match a {
+                    Arg::Input(i) => inputs
+                        .get(usize::from(*i))
+                        .copied()
+                        .ok_or_else(|| "missing numeric slot".into()),
+                    Arg::Step(i) => values
+                        .get(usize::from(*i))
+                        .copied()
+                        .ok_or_else(|| "missing step".into()),
+                    Arg::Constant(i) => CONSTANTS
+                        .get(usize::from(*i))
+                        .ok_or("invalid constant")?
+                        .parse(),
+                }
+            };
+            let a = get(&s.left)?;
+            let b = get(&s.right)?;
+            values.push(match s.op {
+                Op::Add => a.checked_add(b),
+                Op::Subtract => a.checked_sub(b),
+                Op::Multiply => a.checked_mul(b),
+                Op::Divide => a.checked_div(b),
+            }?);
+        }
+        Ok((nums, *values.last().ok_or("empty program")?))
+    }
+}
+pub fn features(question: &str, number_count: usize) -> BTreeSet<usize> {
+    let lower = question.to_ascii_lowercase();
+    let words: Vec<_> = lower
+        .split(|c: char| !c.is_ascii_alphabetic())
+        .filter(|w| !w.is_empty())
+        .collect();
+    let hash = |s: &str| {
+        let mut h = 14695981039346656037_u64;
+        for b in s.bytes() {
+            h = (h ^ u64::from(b)).wrapping_mul(1099511628211);
+        }
+        (h as usize) % FEATURES
+    };
+    let mut out = BTreeSet::new();
+    for w in &words {
+        out.insert(hash(&format!("u:{w}")));
+    }
+    for w in words.windows(2) {
+        if let [a, b] = w {
+            out.insert(hash(&format!("b:{a} {b}")));
+        }
+    }
+    out.insert(hash(&format!("n:{number_count}")));
+    out
+}
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Class {
+    pub program: Program,
+    pub weights: BTreeMap<usize, f64>,
+}
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Model {
+    pub schema: String,
+    pub provenance: String,
+    pub idf: Vec<f64>,
+    pub classes: Vec<Class>,
+}
+#[derive(Debug, Serialize)]
+#[serde(tag = "status", rename_all = "snake_case")]
+pub enum Proposal {
+    Proposed {
+        semantics: &'static str,
+        numbers: Vec<Number>,
+        program: Program,
+        value: String,
+        score: f64,
+        model_provenance: String,
+    },
+    Refusal {
+        reason: String,
+    },
+}
+impl Model {
+    pub fn load(path: &Path) -> Result<Self> {
+        let f = std::fs::File::open(path).map_err(|e| e.to_string())?;
+        let mut bytes = Vec::new();
+        f.take(32 * 1024 * 1024 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|e| e.to_string())?;
+        Self::from_bytes(&bytes)
+    }
+    pub fn from_bytes(bytes: &[u8]) -> Result<Self> {
+        if bytes.len() > 32 * 1024 * 1024 {
+            return Err("model exceeds 32MiB".into());
+        }
+        let m: Self = serde_json::from_slice(bytes).map_err(|e| e.to_string())?;
+        m.validate()?;
+        Ok(m)
+    }
+    pub fn validate(&self) -> Result<()> {
+        if self.schema != "equation-centroid-v1"
+            || self.provenance.is_empty()
+            || self.provenance.len() > 1024
+            || self.idf.len() != FEATURES
+            || self.classes.is_empty()
+            || self.classes.len() > 512
+        {
+            return Err("invalid model shape".into());
+        }
+        if self
+            .idf
+            .iter()
+            .any(|v| !v.is_finite() || *v < 1.0 || *v > 32.0)
+        {
+            return Err("invalid idf".into());
+        }
+        for c in &self.classes {
+            c.program.validate()?;
+            if c.weights.is_empty()
+                || c.weights
+                    .iter()
+                    .any(|(i, v)| *i >= FEATURES || !v.is_finite() || *v < 0.0 || *v > 1.0)
+            {
+                return Err("invalid model weight".into());
+            }
+        }
+        Ok(())
+    }
+    pub fn propose(&self, question: &str) -> Proposal {
+        match self.propose_checked(question) {
+            Ok(p) => p,
+            Err(reason) => Proposal::Refusal { reason },
+        }
+    }
+    fn propose_checked(&self, question: &str) -> Result<Proposal> {
+        self.validate()?;
+        let nums = numbers(question)?;
+        let fs = features(question, nums.len());
+        let norm = fs
+            .iter()
+            .filter_map(|i| self.idf.get(*i))
+            .map(|v| v * v)
+            .sum::<f64>()
+            .sqrt();
+        let mut best: Option<(usize, f64)> = None;
+        for (i, c) in self.classes.iter().enumerate() {
+            let score = fs
+                .iter()
+                .map(|f| {
+                    c.weights.get(f).copied().unwrap_or(0.0)
+                        * self.idf.get(*f).copied().unwrap_or(0.0)
+                        / norm
+                })
+                .sum::<f64>();
+            if !score.is_finite() {
+                return Err("nonfinite score".into());
+            }
+            if best.is_none_or(|(_, s)| score > s) {
+                best = Some((i, score));
+            }
+        }
+        let (i, score) = best.ok_or("empty model")?;
+        let c = self.classes.get(i).ok_or("missing class")?;
+        let (numbers, value) = c.program.execute(question)?;
+        Ok(Proposal::Proposed {
+            semantics: "unverified",
+            numbers,
+            program: c.program.clone(),
+            value: value.to_string(),
+            score,
+            model_provenance: self.provenance.clone(),
+        })
+    }
+}
