+//! Question-only candidate and exact counterfactual; no runtime annotation input.
+use glassmind_everyday::IntentModel;
+use glassmind_facts::{Store, quality::QualityConstraint};
+use std::io::{self, BufRead};
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    let [_, model_path, index_path, policy] = args.as_slice() else {
+        return Err("usage: linkquality_predictions MODEL INDEX POLICY_JSON < questions".into());
+    };
+    let model: IntentModel = serde_json::from_slice(&std::fs::read(model_path)?)?;
+    let store: Store = serde_json::from_slice(&std::fs::read(index_path)?)?;
+    let policy: Option<QualityConstraint> = serde_json::from_str(policy)?;
+    model.validate()?;
+    store.validate()?;
+    for line in io::stdin().lock().lines() {
+        let question = line?;
+        let baseline = store.answer(&model, &question);
+        let candidate = store.answer_with_quality(&model, &question, policy);
+        println!(
+            "{}",
+            serde_json::json!({"baseline":baseline,"candidate":candidate})
+        );
+    }
+    Ok(())
+}
