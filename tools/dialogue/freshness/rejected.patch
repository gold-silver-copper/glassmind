@@ -0,0 +1,35 @@
+//! Offline frozen classifier diagnostics; inputs contain only utterances.
+use glassmind_dialogue::{
+    multi::MultiModel,
+    tracker::{InputTurn, Speaker},
+};
+use std::{
+    fs::File,
+    io::{BufReader, BufWriter},
+};
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<String> = std::env::args().collect();
+    let [_, model_path, input_path, output_path] = args.as_slice() else {
+        return Err("model input output required".into());
+    };
+    let model: MultiModel = serde_json::from_reader(BufReader::new(File::open(model_path)?))?;
+    let input: Vec<Vec<InputTurn>> =
+        serde_json::from_reader(BufReader::new(File::open(input_path)?))?;
+    let mut output = Vec::new();
+    for conversation in input {
+        let mut system = String::new();
+        let mut rows = Vec::new();
+        for (i, t) in conversation.iter().enumerate() {
+            if matches!(t.speaker, Speaker::System) {
+                system.clone_from(&t.utterance);
+                continue;
+            }
+            for (service, m) in &model.services {
+                rows.push(serde_json::json!({"turn":i,"service":service,"tokens":m.span_labels(&t.utterance,&system)}));
+            }
+        }
+        output.push(rows);
+    }
+    serde_json::to_writer(BufWriter::new(File::create(output_path)?), &output)?;
+    Ok(())
+}
