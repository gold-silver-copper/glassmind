index 0000000..8f823cb
--- /dev/null
+++ 2/crates/dialogue/src/bin/dialogue-spansequence-probe.rs
@@ -0,0 +1,47 @@
+//! Utterance-only raw proposal diagnostics, separate from gold auditing.
+use clap::Parser;
+use glassmind_dialogue::{
+    spansequence::{SequenceModel, features, tokenize},
+    tracker::{InputTurn, Speaker},
+};
+use std::{
+    fs::File,
+    io::{BufReader, BufWriter},
+    path::PathBuf,
+};
+#[derive(Parser)]
+struct Args {
+    #[arg(long)]
+    model: PathBuf,
+    #[arg(long)]
+    input: PathBuf,
+    #[arg(long)]
+    output: PathBuf,
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let a = Args::parse();
+    let model: SequenceModel = serde_json::from_reader(BufReader::new(File::open(a.model)?))?;
+    let conversations: Vec<Vec<InputTurn>> =
+        serde_json::from_reader(BufReader::new(File::open(a.input)?))?;
+    let mut result = Vec::new();
+    for turns in conversations {
+        let mut system = String::new();
+        let mut rows = Vec::new();
+        for (i, t) in turns.iter().enumerate() {
+            if matches!(t.speaker, Speaker::System) {
+                system.clone_from(&t.utterance);
+                continue;
+            }
+            let mut services = std::collections::BTreeMap::new();
+            for (s, c) in &model.services {
+                let words = tokenize(&t.utterance).ok_or("oversized input")?;
+                let (tags, margins) = c.decode(&c.encode(&features(&words, &system)));
+                services.insert(s,serde_json::json!({"tokens":words.iter().zip(tags).zip(margins).map(|((w,l),m)|serde_json::json!({"word":w.text,"label":c.labels.get(l),"margin":m})).collect::<Vec<_>>(),"raw":c.propose(s,&t.utterance,&system,0.),"selected":c.propose(s,&t.utterance,&system,model.threshold)}));
+            }
+            rows.push(serde_json::json!({"turn_index":i,"services":services}));
+        }
+        result.push(rows);
+    }
+    serde_json::to_writer(BufWriter::new(File::create(a.output)?), &result)?;
+    Ok(())
+}
