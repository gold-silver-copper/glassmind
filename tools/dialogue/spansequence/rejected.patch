+        let mut session = MultiSession::default();
+        let user = |s: &str| InputTurn {
+            speaker: Speaker::User,
+            utterance: s.into(),
+        };
+        m.advance(&mut session, &user("in Novera Heights"), &schemas);
+        assert_eq!(session.states["s"].slots["city"].text(), "Novera Heights");
+        m.advance(&mut session, &user("no, instead in Zürich Vale!"), &schemas);
+        assert_eq!(session.states["s"].slots["city"].text(), "Zürich Vale");
+        assert_eq!(session.sequence_proposals.len(), 1);
+        m.advance(&mut session, &user("no thanks"), &schemas);
+        assert_eq!(session.states["s"].slots["city"].text(), "Zürich Vale");
+        assert!(session.sequence_proposals.is_empty());
+        let mut fresh = MultiSession::default();
+        m.advance(&mut fresh, &user("no thanks"), &schemas);
+        assert!(fresh.states["s"].slots.is_empty());
+        m.version = 2;
+        assert!(m.validate(&schemas).is_err());
+        m.version = 3;
+        if let Some(q) = m.spansequence.as_mut() {
+            q.threshold = f64::NAN;
+        }
+        assert!(m.validate(&schemas).is_err());
+    }
+}
diff --git 1/crates/dialogue/src/bin/dialogue-spansequence-train.rs 2/crates/dialogue/src/bin/dialogue-spansequence-train.rs
new file mode 100644
index 0000000..a8fd189
--- /dev/null
+++ 2/crates/dialogue/src/bin/dialogue-spansequence-train.rs
@@ -0,0 +1,228 @@
+//! Offline, TRAIN-only averaged structured perceptron. No runtime annotations.
+use clap::Parser;
+use glassmind_dialogue::spansequence::{Chain, SequenceModel, features, tokenize};
+use serde::Deserialize;
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::File,
+    io::{BufReader, BufWriter},
+    path::PathBuf,
+};
+#[derive(Parser)]
+struct Args {
+    #[arg(long)]
+    input: PathBuf,
+    #[arg(long)]
+    output: PathBuf,
+    #[arg(long)]
+    report: PathBuf,
+}
+#[derive(Deserialize)]
+struct Data {
+    slots: BTreeMap<String, Vec<String>>,
+    rows: Vec<Row>,
+}
+#[derive(Deserialize)]
+struct Row {
+    cal: bool,
+    service: String,
+    system: String,
+    utterance: String,
+    spans: Vec<Span>,
+}
+#[derive(Deserialize, serde::Serialize)]
+struct Span {
+    slot: String,
+    start: usize,
+    exclusive_end: usize,
+}
+#[derive(Clone, Default)]
+struct Average {
+    total: f64,
+    last: usize,
+}
+fn update(
+    weights: &mut [Vec<f64>],
+    averages: &mut [Vec<Average>],
+    i: usize,
+    j: usize,
+    delta: f64,
+    step: usize,
+) {
+    if let (Some(w), Some(a)) = (
+        weights.get_mut(i).and_then(|r| r.get_mut(j)),
+        averages.get_mut(i).and_then(|r| r.get_mut(j)),
+    ) {
+        a.total += (step - a.last) as f64 * *w;
+        a.last = step;
+        *w += delta;
+    }
+}
+fn finish(weights: &mut [Vec<f64>], averages: &[Vec<Average>], step: usize) {
+    for (ws, aa) in weights.iter_mut().zip(averages) {
+        for (w, a) in ws.iter_mut().zip(aa) {
+            *w = (a.total + (step - a.last) as f64 * *w) / step.max(1) as f64;
+        }
+    }
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let a = Args::parse();
+    let data: Data = serde_json::from_reader(BufReader::new(File::open(a.input)?))?;
+    if data.rows.len() > 100000 || data.slots.len() > 8 {
+        return Err("training bounds".into());
+    }
+    let mut model = SequenceModel {
+        version: 1,
+        threshold: 0.,
+        services: BTreeMap::new(),
+    };
+    let mut reports = BTreeMap::new();
+    for (service, slots) in &data.slots {
+        let mut labels = vec!["O".to_string()];
+        for s in slots {
+            labels.push(format!("B:{s}"));
+            labels.push(format!("I:{s}"));
+        }
+        let k = labels.len();
+        if k > 32 {
+            return Err("label bounds".into());
+        }
+        let mut train = Vec::new();
+        let mut counts = BTreeMap::<String, usize>::new();
+        for r in data.rows.iter().filter(|r| !r.cal && &r.service == service) {
+            let words = tokenize(&r.utterance).ok_or("oversized train input")?;
+            let fs = features(&words, &r.system);
+            let mut gold = Vec::new();
+            for (i, w) in words.iter().enumerate() {
+                let span = r
+                    .spans
+                    .iter()
+                    .find(|s| w.char_start >= s.start && w.char_end <= s.exclusive_end);
+                let label = span.map_or_else(
+                    || "O".into(),
+                    |s| {
+                        let same = i
+                            .checked_sub(1)
+                            .and_then(|j| words.get(j))
+                            .is_some_and(|p| {
+                                p.char_start >= s.start && p.char_end <= s.exclusive_end
+                            });
+                        format!("{}:{}", if same { "I" } else { "B" }, s.slot)
+                    },
+                );
+                gold.push(
+                    labels
+                        .iter()
+                        .position(|s| s == &label)
+                        .ok_or("unknown gold label")?,
+                );
+            }
+            let unique: BTreeSet<_> = fs.iter().flatten().cloned().collect();
+            for f in unique {
+                *counts.entry(f).or_default() += 1;
+            }
+            train.push((fs, gold));
+        }
+        let mut ranked: Vec<_> = counts.into_iter().filter(|(_, n)| *n >= 2).collect();
+        ranked.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+        ranked.truncate(50000);
+        let vocabulary: BTreeMap<_, _> = ranked
+            .into_iter()
+            .map(|x| x.0)
+            .collect::<BTreeSet<_>>()
+            .into_iter()
+            .enumerate()
+            .map(|(i, s)| (s, i))
+            .collect();
+        let mut c = Chain {
+            labels,
+            vocabulary,
+            emissions: vec![],
+            transitions: vec![vec![0.; k]; k + 1],
+        };
+        c.emissions = vec![vec![0.; k]; c.vocabulary.len()];
+        let train: Vec<_> = train.into_iter().map(|(f, g)| (c.encode(&f), g)).collect();
+        let mut ea = vec![vec![Average::default(); k]; c.emissions.len()];
+        let mut ta = vec![vec![Average::default(); k]; k + 1];
+        let mut step = 0;
+        let mut mistakes = Vec::new();
+        for epoch in 0..8 {
+            let mut errors = 0;
+            for (fs, gold) in &train {
+                let (pred, _) = c.decode(fs);
+                if &pred != gold {
+                    errors += 1;
+                    for (i, ((row, g), p)) in fs.iter().zip(gold).zip(&pred).enumerate() {
+                        if g != p {
+                            for f in row {
+                                update(&mut c.emissions, &mut ea, *f, *g, 1., step);
+                                update(&mut c.emissions, &mut ea, *f, *p, -1., step);
+                            }
+                        }
+                        let gp = i
+                            .checked_sub(1)
+                            .and_then(|j| gold.get(j))
+                            .copied()
+                            .unwrap_or(k);
+                        let pp = i
+                            .checked_sub(1)
+                            .and_then(|j| pred.get(j))
+                            .copied()
+                            .unwrap_or(k);
+                        update(&mut c.transitions, &mut ta, gp, *g, 1., step);
+                        update(&mut c.transitions, &mut ta, pp, *p, -1., step);
+                    }
+                }
+                step += 1;
+            }
+            mistakes.push(errors);
+            eprintln!(
+                "{service} epoch{} mistakes{errors}/{}",
+                epoch + 1,
+                train.len()
+            );
+        }
+        finish(&mut c.emissions, &ea, step);
+        finish(&mut c.transitions, &ta, step);
+        reports.insert(service.clone(),serde_json::json!({"fit_sequences":train.len(),"features":c.vocabulary.len(),"epoch_mistakes":mistakes}));
+        model.services.insert(service.clone(), c);
+    }
+    let thresholds = [0., 2., 4., 8., 16., 32.];
+    let mut totals = vec![(0usize, 0usize); thresholds.len()];
+    let mut calibration_rows = Vec::new();
+    for r in data.rows.iter().filter(|r| r.cal) {
+        let Some(c) = model.services.get(&r.service) else {
+            continue;
+        };
+        let proposals = c.propose(&r.service, &r.utterance, &r.system, 0.);
+        calibration_rows.push(serde_json::json!({"service":r.service,"utterance":r.utterance,"system":r.system,"gold":r.spans,"proposals":proposals}));
+        for p in proposals {
+            let correct = r.spans.iter().any(|s| {
+                s.slot == p.slot && s.start == p.char_start && s.exclusive_end == p.char_end
+            });
+            for (threshold, (total, right)) in thresholds.iter().zip(&mut totals) {
+                if p.margin >= *threshold {
+                    *total += 1;
+                    *right += usize::from(correct);
+                }
+            }
+        }
+    }
+    let selected = thresholds
+        .iter()
+        .zip(&totals)
+        .find(|(_, (n, r))| *n >= 30 && r * 100 >= n * 99)
+        .map(|(t, _)| *t);
+    let report = serde_json::json!({"services":reports,"thresholds":thresholds,"cal_proposals_correct":totals,"selected":selected,"epochs":8,"calibration_rows":calibration_rows});
+    serde_json::to_writer_pretty(BufWriter::new(File::create(a.report)?), &report)?;
+    if selected.is_none() {
+        serde_json::to_writer(
+            BufWriter::new(File::create(a.output.with_extension("unselected.json"))?),
+            &serde_json::json!({"version":1,"services":model.services}),
+        )?;
+    }
+    model.threshold = selected.ok_or("CAL gate failed; no candidate")?;
+    serde_json::to_writer(BufWriter::new(File::create(a.output)?), &model)?;
+    println!("{report}");
+    Ok(())
+}
