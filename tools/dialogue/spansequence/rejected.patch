+//! Optional bounded linear-chain BIO proposals. Runtime consumes text only.
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+const MAX_TOKENS: usize = 256;
+const MAX_BYTES: usize = 4096;
+const NEG: f64 = -1e100;
+#[derive(Debug, Serialize, Deserialize)]
+pub struct SequenceModel {
+    pub version: u32,
+    pub threshold: f64,
+    pub services: BTreeMap<String, Chain>,
+}
+#[derive(Debug, Serialize, Deserialize)]
+pub struct Chain {
+    pub labels: Vec<String>,
+    pub vocabulary: BTreeMap<String, usize>,
+    pub emissions: Vec<Vec<f64>>,
+    /// Last row is start-of-sequence; other rows are learned transitions.
+    pub transitions: Vec<Vec<f64>>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Proposal {
+    pub service: String,
+    pub slot: String,
+    pub value: String,
+    pub start: usize,
+    pub end: usize,
+    pub char_start: usize,
+    pub char_end: usize,
+    pub margin: f64,
+}
+#[derive(Debug)]
+pub struct Token {
+    pub text: String,
+    pub start: usize,
+    pub end: usize,
+    pub char_start: usize,
+    pub char_end: usize,
+}
+pub fn tokenize(text: &str) -> Option<Vec<Token>> {
+    if text.len() > MAX_BYTES {
+        return None;
+    }
+    let mut out = Vec::new();
+    let mut start = None;
+    for (ci, (bi, c)) in text
+        .char_indices()
+        .chain(std::iter::once((text.len(), ' ')))
+        .enumerate()
+    {
+        if c.is_alphanumeric() || c == '\'' || c == '-' {
+            start.get_or_insert((bi, ci));
+        } else if let Some((b, ch)) = start.take() {
+            out.push(Token {
+                text: text.get(b..bi)?.into(),
+                start: b,
+                end: bi,
+                char_start: ch,
+                char_end: ci,
+            });
+            if out.len() > MAX_TOKENS {
+                return None;
+            }
+        }
+    }
+    Some(out)
+}
+fn shape(word: &str) -> String {
+    let mut s = String::new();
+    let mut last = '\0';
+    for c in word.chars() {
+        let x = if c.is_uppercase() {
+            'A'
+        } else if c.is_lowercase() {
+            'a'
+        } else if c.is_numeric() {
+            '0'
+        } else {
+            c
+        };
+        if x != last {
+            s.push(x);
+            last = x;
+        }
+    }
+    s
+}
+pub fn features(words: &[Token], system: &str) -> Vec<Vec<String>> {
+    let sys: BTreeSet<_> = tokenize(system)
+        .unwrap_or_default()
+        .into_iter()
+        .map(|t| t.text.to_lowercase())
+        .collect();
+    words
+        .iter()
+        .enumerate()
+        .map(|(i, t)| {
+            let mut f = vec![
+                "bias".into(),
+                format!("first={}", i == 0),
+                format!("last={}", i + 1 == words.len()),
+            ];
+            for offset in -2isize..=2 {
+                if let Some(w) = i.checked_add_signed(offset).and_then(|j| words.get(j)) {
+                    f.push(format!("w{offset}={}", w.text.to_lowercase()));
+                    f.push(format!("s{offset}={}", shape(&w.text)));
+                    f.push(format!(
+                        "cap{offset}={}",
+                        w.text.chars().next().is_some_and(char::is_uppercase)
+                    ));
+                    f.push(format!(
+                        "num{offset}={}",
+                        w.text.chars().all(char::is_numeric)
+                    ));
+                }
+            }
+            let cs: Vec<_> = t.text.to_lowercase().chars().collect();
+            for n in 1..=3 {
+                if let Some(p) = cs.get(..n) {
+                    f.push(format!("pre{n}={}", p.iter().collect::<String>()));
+                }
+                if let Some(p) = cs.len().checked_sub(n).and_then(|b| cs.get(b..)) {
+                    f.push(format!("suf{n}={}", p.iter().collect::<String>()));
+                }
+            }
+            f.extend(sys.iter().take(32).map(|w| format!("sys={w}")));
+            f.sort();
+            f.dedup();
+            f
+        })
+        .collect()
+}
+fn val(rows: &[Vec<f64>], i: usize, j: usize) -> f64 {
+    rows.get(i).and_then(|r| r.get(j)).copied().unwrap_or(0.)
+}
+fn set(rows: &mut [Vec<f64>], i: usize, j: usize, value: f64) {
+    if let Some(x) = rows.get_mut(i).and_then(|r| r.get_mut(j)) {
+        *x = value;
+    }
+}
+impl Chain {
+    pub fn encode(&self, f: &[Vec<String>]) -> Vec<Vec<usize>> {
+        f.iter()
+            .map(|r| {
+                r.iter()
+                    .filter_map(|x| self.vocabulary.get(x).copied())
+                    .collect()
+            })
+            .collect()
+    }
+    fn legal(&self, previous: usize, next: usize) -> bool {
+        let Some(label) = self.labels.get(next) else {
+            return false;
+        };
+        if let Some(slot) = label.strip_prefix("I:") {
+            self.labels
+                .get(previous)
+                .and_then(|s| s.split_once(':'))
+                .is_some_and(|(_, p)| p == slot)
+        } else {
+            true
+        }
+    }
+    /// Viterbi plus exact token max marginals, never independent BIO decisions.
+    pub fn decode(&self, rows: &[Vec<usize>]) -> (Vec<usize>, Vec<f64>) {
+        let k = self.labels.len();
+        let n = rows.len();
+        if n == 0 || n > MAX_TOKENS || k == 0 || k > 32 {
+            return (vec![], vec![]);
+        }
+        let emit: Vec<Vec<f64>> = rows
+            .iter()
+            .map(|fs| {
+                (0..k)
+                    .map(|y| fs.iter().map(|f| val(&self.emissions, *f, y)).sum())
+                    .collect()
+            })
+            .collect();
+        let mut forward = vec![vec![NEG; k]; n];
+        let mut backptr = vec![vec![0.; k]; n];
+        for i in 0..n {
+            for y in 0..k {
+                let (mut best, mut arg) = (NEG, 0);
+                if i == 0 {
+                    if self.legal(k, y) {
+                        best = val(&self.transitions, k, y);
+                    }
+                } else {
+                    for p in 0..k {
+                        if self.legal(p, y) {
+                            let score = val(&forward, i - 1, p) + val(&self.transitions, p, y);
+                            if score > best {
+                                best = score;
+                                arg = p;
+                            }
+                        }
+                    }
+                }
+                set(&mut forward, i, y, best + val(&emit, i, y));
+                set(&mut backptr, i, y, arg as f64);
+            }
+        }
+        let mut path = vec![0; n];
+        let mut y = (0..k)
+            .max_by(|a, b| {
+                val(&forward, n - 1, *a)
+                    .total_cmp(&val(&forward, n - 1, *b))
+                    .then_with(|| b.cmp(a))
+            })
+            .unwrap_or(0);
+        let best = val(&forward, n - 1, y);
+        for i in (0..n).rev() {
+            if let Some(p) = path.get_mut(i) {
+                *p = y;
+            }
+            y = val(&backptr, i, y) as usize;
+        }
+        let mut backward = vec![vec![0.; k]; n];
+        for i in (0..n - 1).rev() {
+            for p in 0..k {
+                let mut score = NEG;
+                for y in 0..k {
+                    if self.legal(p, y) {
+                        score = score.max(
+                            val(&self.transitions, p, y)
+                                + val(&emit, i + 1, y)
+                                + val(&backward, i + 1, y),
+                        );
+                    }
+                }
+                set(&mut backward, i, p, score);
+            }
+        }
+        let margins = path
+            .iter()
+            .enumerate()
+            .map(|(i, y)| {
+                let alt = (0..k)
+                    .filter(|p| p != y)
+                    .map(|p| val(&forward, i, p) + val(&backward, i, p))
+                    .fold(NEG, f64::max);
+                (best - alt).max(0.)
+            })
+            .collect();
+        (path, margins)
+    }
+    pub fn propose(
+        &self,
+        service: &str,
+        text: &str,
+        system: &str,
+        threshold: f64,
+    ) -> Vec<Proposal> {
+        let Some(words) = tokenize(text) else {
+            return vec![];
+        };
+        if system.len() > MAX_BYTES {
+            return vec![];
+        }
+        let (path, margins) = self.decode(&self.encode(&features(&words, system)));
+        let mut out = Vec::new();
+        let mut i = 0;
+        while i < path.len() {
+            let Some(slot) = path
+                .get(i)
+                .and_then(|y| self.labels.get(*y))
+                .and_then(|s| s.strip_prefix("B:"))
+            else {
+                i += 1;
+                continue;
+            };
+            let mut end = i + 1;
+            while path
+                .get(end)
+                .and_then(|y| self.labels.get(*y))
+                .is_some_and(|s| s.strip_prefix("I:") == Some(slot))
+            {
+                end += 1;
+            }
+            let margin = margins
+                .get(i.saturating_sub(1)..(end + 1).min(path.len()))
+                .unwrap_or_default()
+                .iter()
+                .copied()
+                .fold(f64::INFINITY, f64::min);
+            if margin >= threshold
+                && let (Some(first), Some(last)) = (words.get(i), words.get(end - 1))
+                && let Some(value) = text.get(first.start..last.end)
+            {
+                out.push(Proposal {
+                    service: service.into(),
+                    slot: slot.into(),
+                    value: value.into(),
+                    start: first.start,
+                    end: last.end,
+                    char_start: first.char_start,
+                    char_end: last.char_end,
+                    margin,
+                });
+            }
+            i = end;
+        }
+        out
+    }
+}
+impl SequenceModel {
+    pub fn validate(&self, schemas: &[crate::adapter::Schema]) -> Result<(), String> {
+        if self.version != 1
+            || !self.threshold.is_finite()
+            || self.threshold < 0.
+            || self.services.len() > 8
+        {
+            return Err("invalid sequence header".into());
+        }
+        for (s, c) in &self.services {
+            let schema = schemas
+                .iter()
+                .find(|x| &x.service_name == s)
+                .ok_or("unknown sequence service")?;
+            let k = c.labels.len();
+            if k == 0
+                || k > 32
+                || c.labels.first().map(String::as_str) != Some("O")
+                || c.labels.iter().collect::<BTreeSet<_>>().len() != k
+                || c.vocabulary.len() > 50000
+                || c.emissions.len() != c.vocabulary.len()
+                || c.transitions.len() != k + 1
+            {
+                return Err("invalid sequence dimensions".into());
+            }
+            if c.vocabulary.values().copied().collect::<BTreeSet<_>>()
+                != (0..c.vocabulary.len()).collect()
+                || c.vocabulary.keys().any(|s| s.len() > 8192)
+            {
+                return Err("invalid sequence dictionary".into());
+            }
+            for l in c.labels.iter().skip(1) {
+                let (tag, slot) = l.split_once(':').ok_or("invalid BIO label")?;
+                if !matches!(tag, "B" | "I")
+                    || !schema
+                        .slots
+                        .iter()
+                        .any(|s| s.name == slot && !s.is_categorical)
+                    || !c.labels.contains(&format!("B:{slot}"))
+                    || !c.labels.contains(&format!("I:{slot}"))
+                {
+                    return Err("invalid BIO slot".into());
+                }
+            }
+            if c.emissions
+                .iter()
+                .chain(&c.transitions)
+                .any(|r| r.len() != k || r.iter().any(|v| !v.is_finite() || v.abs() > 1e6))
+            {
+                return Err("invalid sequence weights".into());
+            }
+        }
+        Ok(())
+    }
+    pub fn propose(&self, service: &str, text: &str, system: &str) -> Vec<Proposal> {
+        self.services.get(service).map_or_else(Vec::new, |c| {
+            c.propose(service, text, system, self.threshold)
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn chain() -> Chain {
+        Chain {
+            labels: vec!["O".into(), "B:city".into(), "I:city".into()],
+            vocabulary: BTreeMap::from([
+                ("cap0=true".into(), 0),
+                ("w-1=in".into(), 1),
+                ("bias".into(), 2),
+            ]),
+            emissions: vec![vec![0., 8., 8.], vec![0., 8., 0.], vec![2., -5., -5.]],
+            transitions: vec![vec![0.; 3], vec![0., 0., 1.], vec![0., 0., 1.], vec![0.; 3]],
+        }
+    }
+    #[test]
+    fn novel_unicode_multiword_and_punctuation() {
+        let c = chain();
+        for name in ["Zürich Vale", "Novera Heights"] {
+            let text = format!("no, instead in {name}!");
+            let p = c.propose("s", &text, "", 0.);
+            assert_eq!(p.len(), 1);
+            let p = &p[0];
+            assert_eq!(p.value, name);
+            assert_eq!(text.get(p.start..p.end), Some(name));
+            assert_eq!(
+                text.chars()
+                    .skip(p.char_start)
+                    .take(p.char_end - p.char_start)
+                    .collect::<String>(),
+                name
+            );
+        }
+        assert!(
+            c.propose("s", "no thanks, nothing else.", "", 0.)
+                .is_empty()
+        );
+    }
+    #[test]
+    fn constrained_transition_and_bounds() {
+        let mut c = chain();
+        c.emissions = vec![vec![0., 0., 100.]; 3];
+        let (p, _) = c.decode(&[vec![0], vec![0]]);
+        assert_ne!(p.first(), Some(&2));
+        assert!(tokenize(&"a".repeat(4097)).is_none());
+        assert!(tokenize(&"a ".repeat(257)).is_none());
+        assert!(c.propose("s", "hello", &"x".repeat(4097), 0.).is_empty());
+    }
+    #[test]
+    fn viterbi_marginals_match_exhaustive_paths() {
+        let c = chain();
+        let rows = vec![vec![2], vec![0, 1, 2], vec![0, 2]];
+        let (path, margins) = c.decode(&rows);
+        let mut paths = Vec::new();
+        for a in 0..3 {
+            for b in 0..3 {
+                for d in 0..3 {
+                    let p = vec![a, b, d];
+                    let mut previous = 3;
+                    let mut score = 0.;
+                    let mut valid = true;
+                    for (fs, y) in rows.iter().zip(&p) {
+                        valid &= c.legal(previous, *y);
+                        score += val(&c.transitions, previous, *y)
+                            + fs.iter().map(|f| val(&c.emissions, *f, *y)).sum::<f64>();
+                        previous = *y;
+                    }
+                    if valid {
+                        paths.push((p, score));
+                    }
+                }
+            }
+        }
+        let best = paths.iter().map(|(_, s)| *s).fold(NEG, f64::max);
+        assert_eq!(
+            paths.iter().find(|(p, _)| p == &path).map(|(_, s)| *s),
+            Some(best)
+        );
+        for (i, (y, m)) in path.iter().zip(margins).enumerate() {
+            let alt = paths
+                .iter()
+                .filter(|(p, _)| p.get(i) != Some(y))
+                .map(|(_, s)| *s)
+                .fold(NEG, f64::max);
+            assert!((m - (best - alt)).abs() < 1e-9);
+        }
+    }
+    #[test]
