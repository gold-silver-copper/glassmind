+#[cfg(test)]
+mod tests {
+    use super::*;
+    use glassmind_rules::Switches;
+
+    #[test]
+    fn signatures_only_and_fixed_budget() {
+        let a: syn::ItemFn =
+            syn::parse_str("fn alpha(xs: &[i32]) -> Vec<i32> { todo!() }").unwrap();
+        let b: syn::ItemFn =
+            syn::parse_str("/// sum positive things\nfn 語(xs: &[i32]) -> Vec<i32> { todo!() }")
+                .unwrap();
+        assert_eq!(candidates(&a.sig).unwrap(), candidates(&b.sig).unwrap());
+        assert_eq!(candidates(&a.sig).unwrap().len(), 12);
+    }
+
+    #[test]
+    fn stale_rules_and_native_rollback() {
+        let root = checks::scratch("implement-contract");
+        fs::create_dir_all(root.join("src")).unwrap();
+        fs::write(root.join("Cargo.toml"), "[package]\nname=\"implementation_contract\"\nversion=\"0.1.0\"\nedition=\"2021\"\n[workspace]\n").unwrap();
+        let code = "pub fn sum(xs: &[i32]) -> i32 { todo!() }\n#[cfg(test)] mod tests { use super::*; #[test] fn check() { assert_eq!(sum(&[-7,2,4,9]),8); assert_eq!(sum(&[-3,-2]),-5); } }\n";
+        fs::write(root.join("src/lib.rs"), code).unwrap();
+        let open =
+            |switches: &Switches| RustWorld::open(&[("fixture".into(), root.as_path())], switches);
+        let action = Implement {
+            target: "sum".into(),
+        };
+        let world = open(&Switches::all_on());
+        let proposal = world.propose_implementation(&action).unwrap();
+        for rule in [RUN_CHECK.id, APPLY_CHANGES.id] {
+            let disabled = open(&Switches::without([rule]));
+            assert!(disabled.apply_implementation(&proposal).is_err());
+            assert_eq!(snapshot(&root).unwrap(), proposal.original);
+        }
+        fs::write(root.join("src/lib.rs"), format!("{code}// stale\n")).unwrap();
+        let changed = snapshot(&root).unwrap();
+        assert!(
+            world
+                .apply_implementation(&proposal)
+                .unwrap_err()
+                .contains("source changed")
+        );
+        assert_eq!(snapshot(&root).unwrap(), changed);
+        fs::write(root.join("src/lib.rs"), code).unwrap();
+        assert_eq!(world.apply_implementation(&proposal).unwrap(), 1);
+        let _ = fs::remove_dir_all(root);
+    }
+}
