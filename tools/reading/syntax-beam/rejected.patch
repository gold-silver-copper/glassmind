+        for _ in 0..2 * n {
+            // Keep only four descriptors, not a state clone for every expansion.
+            let mut selected: Vec<(usize, usize, f64)> = Vec::with_capacity(width);
+            for (parent, (state, total)) in beam.iter().enumerate() {
+                let features = parse_features(state, &ws, &tags);
