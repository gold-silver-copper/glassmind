+/// Offset-invariant legal-action objective; retain ascending action order.
+fn legal_log_softmax(scores: &[f32], legal: impl Fn(usize) -> bool) -> Result<Vec<(usize, f64)>> {
+    let mut actions = Vec::new();
+    let mut maximum = f64::NEG_INFINITY;
+    for (action, &score) in scores.iter().enumerate() {
+        if !score.is_finite() {
+            return Err("nonfinite score".into());
+        }
+        if legal(action) {
+            let score = f64::from(score);
+            maximum = maximum.max(score);
+            actions.push((action, score));
+        }
+    }
+    if actions.is_empty() {
+        return Err("no legal transition".into());
+    }
+    let log_sum = actions
+        .iter()
+        .map(|(_, score)| (score - maximum).exp())
+        .sum::<f64>()
+        .ln();
+    if !log_sum.is_finite() {
+        return Err("nonfinite normalization".into());
+    }
+    for (_, score) in &mut actions {
+        *score = (*score - maximum) - log_sum;
+        if !score.is_finite() {
+            return Err("nonfinite normalized score".into());
+        }
+    }
+    Ok(actions)
+}
