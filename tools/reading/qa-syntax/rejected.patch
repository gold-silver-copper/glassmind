+// SPDX-License-Identifier: MIT
+use clap::{Parser, Subcommand};
+use glassmind_reading::qa::{
+    Input, TrainingRow,
+    syntax_v3::{Companion, Session, SyntaxModel},
+};
+use std::{
+    fs::File,
+    io::{BufRead, BufReader, BufWriter, Read, Write},
+    path::PathBuf,
+};
+#[derive(Parser)]
+struct Args {
+    #[arg(long)]
+    syntax: PathBuf,
+    #[command(subcommand)]
+    command: Command,
+}
+#[derive(Subcommand)]
+enum Command {
+    Train {
+        #[arg(long)]
+        input: PathBuf,
+        #[arg(long)]
+        model: PathBuf,
+    },
+    Predict {
+        #[arg(long)]
+        input: PathBuf,
+        #[arg(long)]
+        model: PathBuf,
+    },
+}
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+    let args = Args::parse();
+    let mut bytes = Vec::new();
+    File::open(args.syntax)?
+        .take(128 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)?;
+    let companion = Companion::load(&bytes)?;
+    let mut session = Session::new(&companion);
+    match args.command {
+        Command::Train { input, model } => {
+            let rows: Vec<TrainingRow> = BufReader::new(File::open(input)?)
+                .lines()
+                .map(|l| Ok(serde_json::from_str(&l?)?))
+                .collect::<Result<_, Box<dyn std::error::Error>>>()?;
+            let m = session.train(&rows);
+            m.validate()?;
+            serde_json::to_writer(BufWriter::new(File::create(model)?), &m)?;
+        }
+        Command::Predict { input, model } => {
+            let m: SyntaxModel = serde_json::from_reader(File::open(model)?.take(2 * 1024 * 1024))?;
+            m.validate()?;
+            let mut out = BufWriter::new(std::io::stdout().lock());
+            for line in BufReader::new(File::open(input)?).lines() {
+                let row: Input = serde_json::from_str(&line?)?;
+                let p = session.predict(&row.context, &row.question, &m);
+                let mut value = serde_json::to_value(p)?;
+                value
+                    .as_object_mut()
+                    .ok_or("prediction must be object")?
+                    .insert("semantic_status".into(), serde_json::json!("unverified"));
+                serde_json::to_writer(&mut out, &value)?;
+                writeln!(out)?;
+            }
+        }
+    }
+    Ok(())
+}
+fn main() -> std::process::ExitCode {
+    match run() {
+        Ok(()) => std::process::ExitCode::SUCCESS,
+        Err(e) => {
+            eprintln!("{e}");
+            std::process::ExitCode::FAILURE
+        }
+    }
+}
