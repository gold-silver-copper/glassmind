+// SPDX-License-Identifier: MIT
+//! Exact first-order labeled graph parser. See syntax-graph/PLAN.md for inventory.
+use super::*;
+pub(super) const VERSION: &str = "ewt-labeled-graph-v2";
+pub(super) const BUCKETS: usize = 1 << 21;
+type Matrix = Vec<Vec<Option<f64>>>;
+
+// Each recursive level strictly reduces node count. Missing edges never use infinity.
+fn edmonds(s: &Matrix) -> Result<Vec<usize>> {
+    let n = s.len();
+    let mut parents = vec![0; n];
+    for d in 1..n {
+        let mut selected = None;
+        for (h, row) in s.iter().enumerate() {
+            if let Some(v) = row[d]
+                && selected.is_none_or(|(_, old)| v > old)
+            {
+                selected = Some((h, v));
+            }
+        }
+        parents[d] = selected.ok_or("disconnected score graph")?.0;
+    }
+    let mut cycle = Vec::new();
+    for start in 1..n {
+        let mut path = Vec::new();
+        let mut v = start;
+        while v != 0 {
+            if let Some(pos) = path.iter().position(|&x| x == v) {
+                cycle = path[pos..].to_vec();
+                break;
+            }
+            path.push(v);
+            v = parents[v];
+        }
+        if !cycle.is_empty() {
+            break;
+        }
+    }
+    if cycle.is_empty() {
+        return Ok(parents);
+    }
+    let mut inside = vec![false; n];
+    for &v in &cycle {
+        inside[v] = true;
+    }
+    let outside: Vec<_> = (0..n).filter(|&v| !inside[v]).collect();
+    let c = outside.len();
+    let mut map = vec![c; n];
+    for (i, &v) in outside.iter().enumerate() {
+        map[v] = i;
+    }
+    let mut contracted = vec![vec![None; c + 1]; c + 1];
+    let mut endpoints = vec![vec![(0, 0); c + 1]; c + 1];
+    for h in 0..n {
+        for d in 1..n {
+            if map[h] == map[d] {
+                continue;
+            }
+            if let Some(mut value) = s[h][d] {
+                if inside[d] {
+                    value -= s[parents[d]][d].ok_or("missing cycle edge")?;
+                }
+                if !value.is_finite() {
+                    return Err("nonfinite contraction".into());
+                }
+                let cell = &mut contracted[map[h]][map[d]];
+                if cell.is_none_or(|old| value > old) {
+                    *cell = Some(value);
+                    endpoints[map[h]][map[d]] = (h, d);
+                }
+            }
+        }
+    }
+    let small = edmonds(&contracted)?;
+    for d in 1..small.len() {
+        let (h, v) = endpoints[small[d]][d];
+        parents[v] = h;
+    }
+    Ok(parents)
+}
+fn decode(s: &Matrix) -> Result<Vec<usize>> {
+    let n = s.len();
+    if !(2..=MAX_TOKENS + 1).contains(&n) || s.iter().any(|r| r.len() != n) {
+        return Err("score dimensions".into());
+    }
+    for (h, row) in s.iter().enumerate() {
+        for (d, v) in row.iter().enumerate() {
+            if v.is_some_and(|v| !v.is_finite()) || ((h == d || d == 0) && v.is_some()) {
+                return Err("invalid score matrix".into());
+            }
+        }
+    }
+    let initial = edmonds(s)?;
+    if initial[1..].iter().filter(|&&h| h == 0).count() == 1 {
+        return Ok(initial);
+    }
+    let mut best_tree = None;
+    let mut best_score = None;
+    for root in 1..n {
+        if s[0][root].is_none() {
+            continue;
+        }
+        let mut constrained = s.clone();
+        for d in 1..n {
+            if d != root {
+                constrained[0][d] = None;
+            } else {
+                for row in constrained.iter_mut().skip(1) {
+                    row[d] = None;
+                }
+            }
+        }
+        let Ok(tree) = edmonds(&constrained) else {
+            continue;
+        };
+        let mut total = 0.;
+        for d in 1..n {
+            total += s[tree[d]][d].ok_or("missing decoded edge")?;
+        }
+        if !total.is_finite() {
+            return Err("nonfinite tree score".into());
+        }
+        if best_score.is_none_or(|old| total > old) {
+            best_score = Some(total);
+            best_tree = Some(tree);
+        }
+    }
+    best_tree.ok_or_else(|| "no single-root tree".into())
+}
+fn features(ws: &[Word], tags: &[usize], h: usize, d: usize, label: Option<usize>) -> Vec<usize> {
+    let w = |i: usize| if i == 0 { 1 } else { ws[i - 1].word };
+    let t = |i: usize| if i == 0 { 1 } else { tags[i - 1] as u64 + 2 };
+    let neighbor = |i: usize, off: isize| {
+        i.checked_add_signed(off)
+            .filter(|&j| j > 0 && j <= tags.len())
+            .map_or(0, t)
+    };
+    let (hw, dw, ht, dt) = (w(h), w(d), t(h), t(d));
+    let direction = u64::from(h < d);
+    let dist = match h.abs_diff(d) {
+        0..=4 => h.abs_diff(d) as u64,
+        5..=7 => 5,
+        8..=15 => 6,
+        _ => 7,
+    };
+    let mut out = Vec::with_capacity(32);
+    if let Some(l) = label {
+        let vals: &[&[u64]] = &[
+            &[],
+            &[ht],
+            &[dt],
+            &[ht, dt],
+            &[hw],
+            &[dw],
+            &[hw, dt],
+            &[ht, dw],
+            &[ht, dt, direction],
+            &[ht, dt, direction, dist],
+            &[hw, direction],
+            &[dw, direction],
+        ];
+        for (i, vals) in vals.iter().enumerate() {
+            feature(&mut out, BUCKETS, 3000 + l as u64 * 64 + i as u64, vals);
+        }
+    } else {
+        for (i, mut vals) in [
+            vec![],
+            vec![ht],
+            vec![dt],
+            vec![hw],
+            vec![dw],
+            vec![ht, dt],
+            vec![hw, dw],
+            vec![hw, dt],
+            vec![ht, dw],
+            vec![hw, ht],
+            vec![dw, dt],
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            feature(&mut out, BUCKETS, 2000 + i as u64, &vals);
+            vals.extend([direction, dist]);
+            feature(&mut out, BUCKETS, 2011 + i as u64, &vals);
+        }
+        let (hl, hr, dl, dr) = (
+            neighbor(h, -1),
+            neighbor(h, 1),
+            neighbor(d, -1),
+            neighbor(d, 1),
+        );
+        for (i, mut vals) in [
+            vec![hl, ht, dt],
+            vec![hr, ht, dt],
+            vec![ht, dl, dt],
+            vec![ht, dr, dt],
+            vec![hl, ht, dl, dt],
+            vec![ht, hr, dt, dr],
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            vals.extend([direction, dist]);
+            feature(&mut out, BUCKETS, 2022 + i as u64, &vals);
+        }
+    }
+    out
+}
+fn parse(
+    table: &Table,
+    ws: &[Word],
+    tags: &[usize],
+    labels: usize,
+    root: usize,
+) -> Result<(Vec<usize>, Vec<usize>)> {
+    let n = ws.len() + 1;
+    let mut scores = vec![vec![None; n]; n];
+    let mut labs = vec![vec![root; n]; n];
+    let score = |f: Vec<usize>| f.iter().map(|&i| f64::from(table.weights[i])).sum::<f64>();
+    for h in 0..n {
+        for d in 1..n {
+            if h == d {
+                continue;
+            }
+            let shared = score(features(ws, tags, h, d, None));
+            let mut winner = None;
+            for l in 0..labels {
+                if (h == 0) != (l == root) {
+                    continue;
+                }
+                let value = shared + score(features(ws, tags, h, d, Some(l)));
+                if !value.is_finite() {
+                    return Err("nonfinite arc score".into());
+                }
+                if winner.is_none_or(|(_, old)| value > old) {
+                    winner = Some((l, value));
+                }
+            }
+            let (l, value) = winner.ok_or("no legal arc label")?;
+            scores[h][d] = Some(value);
+            labs[h][d] = l;
+        }
+    }
+    let heads = decode(&scores)?;
+    let labels = (1..n).map(|d| labs[heads[d]][d]).collect();
+    Ok((heads[1..].to_vec(), labels))
+}
+pub(super) fn infer(
+    m: &Model,
+    forms: &[String],
+    ws: &[Word],
+    tags: &[usize],
+) -> Result<Prediction> {
+    let (heads, labs) = parse(&m.parser, ws, tags, m.labels.len(), m.root)?;
+    let deprels: Vec<_> = labs.iter().map(|&l| m.labels[l].clone()).collect();
+    if !valid_tree(&heads, &deprels) {
+        return Err("invalid graph tree".into());
+    }
+    Ok(Prediction {
+        status: "predicted".into(),
+        model_version: VERSION.into(),
+        tokenization: "provided_forms".into(),
+        forms: forms.to_vec(),
+        spans: None,
+        upos: tags.iter().map(|&t| m.tags[t].clone()).collect(),
+        heads,
+        deprels,
+        structurally_valid: true,
+    })
+}
+/// Consumes an approved legacy model; copies its tagger without any fitting.
+pub(super) fn train(
+    data: &[TrainingSentence],
+    mut frozen: Model,
+) -> Result<(Model, TrainingReport)> {
+    if frozen.graph || data.is_empty() || data.len() > 100_000 {
+        return Err("requires legacy tagger and bounded TRAIN".into());
+    }
+    frozen.graph = true;
+    let mut report = TrainingReport {
+        sentences: data.len(),
+        words: data.iter().map(|s| s.forms.len()).sum(),
+        parser_epochs: 3,
+        ..Default::default()
+    };
+    let mut eligible = Vec::new();
+    for (i, s) in data.iter().enumerate() {
+        if s.forms.len() != s.heads.len()
+            || s.forms.len() != s.labels.len()
+            || s.forms.len() != s.upos.len()
+        {
+            return Err("annotation lengths".into());
+        }
+        if validate_forms(&s.forms).is_err() {
+            report.input_skips += 1;
+            continue;
+        }
+        if !valid_tree(&s.heads, &s.labels) {
+            report.invalid_tree_skips += 1;
+            continue;
+        }
+        let ws = words(&s.forms);
+        let tags = frozen.tag(&ws)?;
+        let labs = s
+            .labels
+            .iter()
+            .map(|l| {
+                frozen
+                    .labels
+                    .binary_search(l)
+                    .map_err(|_| "unknown TRAIN label".into())
+            })
+            .collect::<Result<Vec<_>>>()?;
+        eligible.push((i, ws, tags, labs));
+    }
+    report.parser_sentences = eligible.len();
+    let mut learner = Learner::new(1, BUCKETS);
+    for epoch in 0..3 {
+        let mut mistakes = 0;
+        for (i, ws, tags, labs) in &eligible {
+            let g = &data[*i];
+            let (heads, predlabs) =
+                parse(&learner.table, ws, tags, frozen.labels.len(), frozen.root)?;
+            learner.step += 1;
+            for d in 1..=ws.len() {
+                if (g.heads[d - 1], labs[d - 1]) == (heads[d - 1], predlabs[d - 1]) {
+                    continue;
+                }
+                mistakes += 1;
+                for (h, l, delta) in [
+                    (g.heads[d - 1], labs[d - 1], 1.),
+                    (heads[d - 1], predlabs[d - 1], -1.),
+                ] {
+                    for f in features(ws, tags, h, d, None).into_iter().chain(features(
+                        ws,
+                        tags,
+                        h,
+                        d,
+                        Some(l),
+                    )) {
+                        learner.totals[f] += f64::from(learner.step - learner.last[f])
+                            * f64::from(learner.table.weights[f]);
+                        learner.last[f] = learner.step;
+                        learner.table.weights[f] += delta;
+                    }
+                }
+            }
+        }
+        report.parser_mistakes.push(mistakes);
+        eprintln!("graph epoch {} mistakes {}", epoch + 1, mistakes);
+    }
+    frozen.parser = learner.finish();
+    Ok((frozen, report))
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+    fn exhaustive(s: &Matrix) -> f64 {
+        let n = s.len() - 1;
+        let mut best = f64::NEG_INFINITY;
+        for mut code in 0..(n + 1).pow(n as u32) {
+            let mut heads = Vec::new();
+            for _ in 0..n {
+                heads.push(code % (n + 1));
+                code /= n + 1;
+            }
+            let labels = heads
+                .iter()
+                .map(|&h| if h == 0 { "root".into() } else { "dep".into() })
+                .collect::<Vec<_>>();
+            if !valid_tree(&heads, &labels) {
+                continue;
+            }
+            let values = heads
+                .iter()
+                .enumerate()
+                .map(|(d, &h)| s[h][d + 1])
+                .collect::<Option<Vec<_>>>();
+            if let Some(values) = values {
+                best = best.max(values.iter().sum());
+            }
+        }
+        best
+    }
+    #[test]
+    fn exhaustive_independent_matrices() {
+        let mut seed = 73u64;
+        for n in 1..=5 {
+            for case in 0..100 {
+                let mut s = vec![vec![None; n + 1]; n + 1];
+                for (h, row) in s.iter_mut().enumerate() {
+                    for (d, cell) in row.iter_mut().enumerate().skip(1) {
+                        if h == d {
+                            continue;
+                        }
+                        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+                        *cell = Some(if case == 0 {
+                            0.
+                        } else {
+                            (seed >> 32) as i32 as f64 % 7. - 3.
+                        });
+                    }
+                }
+                let p = decode(&s).unwrap();
+                let score: f64 = (1..=n).map(|d| s[p[d]][d].unwrap()).sum();
+                assert_eq!(score, exhaustive(&s), "n={n} case={case}");
+                assert_eq!(p, decode(&s).unwrap());
+            }
+        }
+    }
+    #[test]
+    fn nested_cycles_multiroot_negative_and_invalid() {
+        let mut s = vec![vec![None; 5]; 5];
+        for (h, row) in s.iter_mut().enumerate() {
+            for (d, c) in row.iter_mut().enumerate().skip(1) {
+                if h != d {
+                    *c = Some(-20.);
+                }
+            }
+        }
+        // 1<->2, 3<->4; their contractions form another cycle.
+        for (h, d, v) in [
+            (1, 2, 10.),
+            (2, 1, 10.),
+            (3, 4, 10.),
+            (4, 3, 10.),
+            (2, 3, 9.),
+            (4, 1, 9.),
+        ] {
+            s[h][d] = Some(v);
+        }
+        let p = decode(&s).unwrap();
+        assert_eq!(
+            (1..5).map(|d| s[p[d]][d].unwrap()).sum::<f64>(),
+            exhaustive(&s)
+        );
+        for cell in s[0].iter_mut().skip(1) {
+            *cell = Some(100.);
+        }
+        assert_eq!(edmonds(&s).unwrap()[1..], [0, 0, 0, 0]);
+        let p = decode(&s).unwrap();
+        assert_eq!(p[1..].iter().filter(|&&h| h == 0).count(), 1);
+        assert_eq!(
+            (1..5).map(|d| s[p[d]][d].unwrap()).sum::<f64>(),
+            exhaustive(&s)
+        );
+        s[0][1] = Some(f64::NAN);
+        assert!(decode(&s).is_err());
+        assert!(decode(&vec![vec![None; 3]; 3]).is_err());
+    }
+}
