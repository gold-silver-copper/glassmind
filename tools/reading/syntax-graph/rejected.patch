+            m.graph = graph;
+            if graph {
+                m.parser = Table::new(1, BUCKETS);
+            }
+            m.parser.weights[1] = 1.;
+            let mut b = Vec::new();
+            m.save(&mut b).unwrap();
+            let loaded = Model::load(b.as_slice()).unwrap();
+            assert_eq!(loaded.version(), m.version());
+            let mut again = Vec::new();
+            loaded.save(&mut again).unwrap();
+            assert_eq!(b, again);
+            for n in [1, 4, 128] {
+                let forms = vec!["x".into(); n];
+                let p = loaded.infer(&forms).unwrap();
+                assert!(valid_tree(&p.heads, &p.deprels));
+            }
+            assert!(loaded.infer(&vec!["x".into(); 129]).is_err());
+            assert!(
+                loaded
+                    .predict(Input {
+                        forms: None,
+                        text: Some("x".repeat(MAX_BYTES + 1))
+                    })
+                    .is_err()
+            );
+            let end = b.len();
+            b[end - 4..].copy_from_slice(&f32::INFINITY.to_bits().to_le_bytes());
+            assert!(Model::load(b.as_slice()).is_err());
+            b = again.clone();
+            b[24] = b'!';
+            assert!(Model::load(b.as_slice()).is_err());
+            b = again;
+            b.push(0);
+            assert!(Model::load(b.as_slice()).is_err());
+        }
+    }
+    #[test]
+    fn supplied_models_roundtrip_when_requested() {
+        let Ok(paths) = std::env::var("SYNTAX_GRAPH_MODELS") else {
+            return;
+        };
+        let mut taggers = Vec::new();
+        for path in paths.split(':') {
+            let bytes = std::fs::read(path).unwrap();
+            let m = Model::load(bytes.as_slice()).unwrap();
+            taggers.push(
+                m.tagger
+                    .weights
+                    .iter()
+                    .map(|v| v.to_bits())
+                    .collect::<Vec<_>>(),
+            );
+            let mut again = Vec::new();
+            m.save(&mut again).unwrap();
+            assert_eq!(bytes, again);
+        }
+        assert!(taggers.windows(2).all(|p| p[0] == p[1]));
+    }
+}
