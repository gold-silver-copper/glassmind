+    #[test]
+    fn both_versions_roundtrip_and_reject_corruption() {
+        for version in [FeatureVersion::Legacy, FeatureVersion::Children] {
+            let mut m = tiny();
+            m.feature_version = version;
+            m.parser.weights[0] = 1.;
+            let mut bytes = Vec::new();
+            m.save(&mut bytes).unwrap();
+            let loaded = Model::load(bytes.as_slice()).unwrap();
+            assert_eq!(loaded.version(), version.name());
+            assert_eq!(
+                loaded.infer(&["word".into()]).unwrap().model_version,
+                version.name()
+            );
+            let mut again = Vec::new();
+            loaded.save(&mut again).unwrap();
+            assert_eq!(bytes, again);
+            let mut bad_version = bytes.clone();
+            let len = u32::from_le_bytes(bytes[8..12].try_into().unwrap()) as usize;
+            let end = 12 + len;
+            let at = bytes[12..end]
+                .windows(version.name().len())
+                .position(|w| w == version.name().as_bytes())
+                .unwrap()
+                + 12;
+            bad_version[at] = b'x';
+            assert!(Model::load(bad_version.as_slice()).is_err());
+            for value in [f32::NAN, f32::INFINITY, 1_000_001., 0.] {
+                let mut bad = bytes.clone();
+                let n = bad.len();
+                bad[n - 4..].copy_from_slice(&value.to_bits().to_le_bytes());
+                assert!(Model::load(bad.as_slice()).is_err());
+            }
+            let mut bad = bytes.clone();
+            bad[end..end + 4].copy_from_slice(&u32::MAX.to_le_bytes());
+            assert!(Model::load(bad.as_slice()).is_err());
+        }
+    }
