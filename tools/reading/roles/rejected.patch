+                "left",
+                if i > s {
+                    ts[i - 1].word.as_str()
+                } else {
+                    "<s>"
+                },
+            ),
+            ("right", if j < e { ts[j].word.as_str() } else { "</s>" }),
+            ("first", ts[i].word.as_str()),
+            ("last", ts[j - 1].word.as_str()),
+        ] {
+            add(f, &["headboundary", stem(head), role, stem(word)], 1.0);
+        }
+    }
+}
