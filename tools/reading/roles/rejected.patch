+        let mut near_left = None;
+        let mut near_right = None;
+        let mut side_counts = [0.0f32; 3];
+        for k in s..e {
+            let Some(q) = self.matches[k] else {
+                continue;
+            };
+            coverage.insert(q);
+            let (side, gap, slot) = if k < i {
+                ("left", i - k, 0)
+            } else if k >= j {
+                ("right", k - j + 1, 1)
+            } else {
+                ("inside", 0, 2)
+            };
+            side_counts[slot] += 1.0 / (gap.max(1) as f32);
+            if k < i {
+                near_left = Some((k, q));
+            }
+            if k >= j && near_right.is_none() {
+                near_right = Some((k, q));
+            }
+            if gap > 16 {
