+// Version2 adds relative anchors; none of these operations execute for version1.
+fn stem(word: &str) -> &str {
+    for suffix in ["ing", "ied", "ed", "es", "s"] {
+        if let Some(base) = word.strip_suffix(suffix)
+            && base.len() >= 3
+        {
+            return base;
+        }
+    }
+    word
+}
+fn negative(word: &str) -> bool {
+    matches!(word, "not" | "never" | "no" | "neither" | "without")
+        || word.ends_with("n't")
+        || word.ends_with("n’t")
+}
+fn auxiliary(word: &str) -> bool {
+    matches!(
+        word,
+        "did"
+            | "does"
+            | "do"
+            | "was"
+            | "were"
+            | "is"
+            | "are"
+            | "has"
+            | "have"
+            | "had"
+            | "can"
+            | "could"
+            | "would"
+            | "will"
+    )
+}
+fn distance(n: usize) -> &'static str {
+    match n {
+        0 => "0",
+        1 => "1",
+        2 => "2",
+        3..=4 => "3-4",
+        5..=8 => "5-8",
+        _ => "9+",
+    }
+}
