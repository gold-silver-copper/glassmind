+            add(f, &["aligncountwh", wh, side], value);
+            add(f, &["aligncounthead", head, side], value);
+        }
+        let covered = coverage.len() as f32 / self.content.len().max(1) as f32;
+        add(f, &["stemcoverage"], covered);
+        add(f, &["stemcoveragewh", wh], covered);
+        for (side, nearest) in [("left", near_left), ("right", near_right)] {
