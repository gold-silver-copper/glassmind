+                let after = qs.get(q + 1).map_or("</s>", |t| t.word.as_str());
+                add(f, &["nearest", wh, side, d, before], 1.0);
+                add(f, &["nearestafter", wh, side, d, after], 1.0);
+                add(f, &["nearesthead", head, side, d], 1.0);
+            }
+        }
